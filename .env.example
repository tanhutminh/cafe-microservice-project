# Copy this file to .env (gitignored) before running `docker compose up -d`.
# Dev-only credentials, real values (not placeholders) - docker-compose.yml/.env are not a
# security boundary for this project, so committing real, working dev values here is fine.
# --- Postgres bootstrap superuser ---
