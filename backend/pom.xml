<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.cafe</groupId>
  <artifactId>backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>cafe-backend</name>

  <modules>
    <module>common-lib</module>
    <module>gateway</module>
    <module>auth-service</module>
    <module>menu-service</module>
    <module>order-service</module>
    <module>inventory-service</module>
    <module>report-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- One fixed timestamp for the entries of every jar the build writes, Spring Boot's
         repackaged jar included, instead of the build time, so the same sources built with the
         same JDK and plugins give byte-identical jars (a reproducible build).
         spring-boot-maven-plugin's repackage goal accepts a fixed date from
         1980-01-01T00:00:02Z to the end of 2099. This one is a month after that lower bound, so
         it falls after the zip format's 1980 start in every time zone. -->
    <project.build.outputTimestamp>1980-02-01T00:00:00Z</project.build.outputTimestamp>

    <spring-boot.version>4.1.0</spring-boot.version>
    <spring-cloud.version>2025.1.2</spring-cloud.version>

    <jjwt.version>0.13.0</jjwt.version>
    <resilience4j.version>2.3.0</resilience4j.version>
    <springdoc.version>2.8.6</springdoc.version>
    <!-- The OpenAPI annotations version to compile against where springdoc doesn't supply it. A
         module with springdoc runs with the version springdoc's swagger-core depends on instead
         (swagger-api.version in springdoc's parent pom, org.springdoc:springdoc-openapi), so keep
         this one no newer than that: at runtime the JVM silently drops an annotation or attribute
         that version lacks, and an attribute set to an enum constant it lacks throws when read. -->
    <swagger-annotations.version>2.2.29</swagger-annotations.version>
    <mockwebserver.version>4.12.0</mockwebserver.version>
    <jacoco.version>0.8.12</jacoco.version>
    <!-- Minimum LINE coverage enforced by `mvn jacoco:check`: the project's 70% target. A module
         still below it overrides this in its own <properties> with its current floor (a ratchet:
         raise it as coverage improves, never lower it); modules at or above it inherit it. -->
    <jacoco.line.coverage.minimum>0.70</jacoco.line.coverage.minimum>
    <!-- Empty default for the @{argLine} that maven-surefire-plugin's argLine below extends:
         jacoco's prepare-agent sets argLine only in the modules that run it, and in the others,
         without this default, the test JVM would get a literal "@{argLine}" and fail to start. -->
    <argLine/>
    <spotless.version>2.44.3</spotless.version>
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-dependency-plugin.version>3.10.0</maven-dependency-plugin.version>
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-jar-plugin.version>3.5.0</maven-jar-plugin.version>
    <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
    <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
    <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
    <maven-project-info-reports-plugin.version>3.9.0</maven-project-info-reports-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <google-java-format.version>1.25.2</google-java-format.version>
    <sortpom-sorter.version>4.0.0</sortpom-sorter.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>com.cafe</groupId>
        <artifactId>common-lib</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-api</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-impl</artifactId>
        <version>${jjwt.version}</version>
        <scope>runtime</scope>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-jackson</artifactId>
        <version>${jjwt.version}</version>
        <scope>runtime</scope>
      </dependency>

      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-spring-boot3</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>

      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>

      <dependency>
        <groupId>com.squareup.okhttp3</groupId>
        <artifactId>mockwebserver</artifactId>
        <version>${mockwebserver.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Every module needs the same test framework the same way (test scope, version from the
       Spring Boot BOM) - an actual inherited dependency here, not just dependencyManagement,
       so no module has to declare or can forget it. -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- application-local.yml (per-module, gitignored - see application-local.yml.example)
         holds dev-only secrets for running a service bare from an IDE. It must never end up in
         a built jar/image - an accidental SPRING_PROFILES_ACTIVE=local on a real deployment
         would silently activate this dev keypair/credentials instead of the real ones. -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>application-local.yml</exclude>
          <!-- Not a security risk (Spring never loads a .example file), just build-artifact
               tidiness - no reason to ship a copy of the dev-secrets template in every image. -->
          <exclude>application-local.yml.example</exclude>
        </excludes>
      </resource>
    </resources>
    <pluginManagement>
      <plugins>
        <!-- Repackages the jar of each module that declares this plugin into an executable one
             (`java -jar`). The plugin's repackage goal copies provided-scope dependencies into
             the jar's BOOT-INF/lib too, so lombok, which only the compiler needs, is excluded
             here. That keeps lombok out of the jar and so out of the module's image. -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
          <configuration>
            <excludes>
              <exclude>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
              </exclude>
            </excludes>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>repackage</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <!-- Compiles each module's main and test sources for the Java release in the java.version
             property, running lombok as an annotation processor. <parameters> (javac -parameters)
             records method parameter names where reflection can read them, so Spring can bind,
             for example, a @PathVariable or @RequestParam declared without a name. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${java.version}</release>
            <parameters>true</parameters>
            <annotationProcessorPaths>
              <!-- No <version>: maven-compiler-plugin 3.12.0 and later take it from
                   dependencyManagement, here the Spring Boot BOM, so the processor matches the
                   lombok the modules compile against. -->
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <!-- Backend counterpart to the frontend's `npm run test:coverage`: a browsable
             per-file HTML report under target/site/jacoco, opt in per-module. -->
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <configuration>
            <rules>
              <rule>
                <element>BUNDLE</element>
                <limits>
                  <limit>
                    <counter>LINE</counter>
                    <value>COVEREDRATIO</value>
                    <minimum>${jacoco.line.coverage.minimum}</minimum>
                  </limit>
                </limits>
              </rule>
            </rules>
          </configuration>
          <executions>
            <execution>
              <id>jacoco-prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>jacoco-report</id>
              <goals>
                <goal>report</goal>
              </goals>
              <phase>test</phase>
            </execution>
          </executions>
        </plugin>
        <!-- Runs each module's tests in a forked JVM. The argLine below extends @{argLine}, which
             is resolved only when the tests start, so it keeps the -javaagent flag that jacoco's
             prepare-agent puts in argLine. A value without @{argLine} would replace that flag,
             and so would ${argLine}: Maven resolves it while building the project model, before
             prepare-agent runs, to the empty default in <properties>. -Duser.timezone=UTC, which
             every module's tests get, is there for the ones that start Postgres: the Postgres
             JDBC driver sends the JVM's default time zone as the TimeZone parameter of each
             connection, and a Postgres server started by Testcontainers rejects a time zone name
             its OS's time zone database lacks. The Debian-based postgres image the tests use
             ships without the tzdata-legacy package, so on a machine whose OS reports an old IANA
             alias such as Asia/Saigon (now Asia/Ho_Chi_Minh), every connection would fail. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <argLine>@{argLine} -Duser.timezone=UTC</argLine>
          </configuration>
        </plugin>
        <!-- Resolves, copies and analyzes dependencies. This build binds none of this plugin's
             goals to a lifecycle phase, so they run only when called directly. For example,
             `mvn dependency:go-offline` fetches the reactor's third-party dependencies into the
             local repository (~/.m2/repository). It also fetches every plugin with a goal bound to
             a lifecycle phase in this parent or a module. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven-dependency-plugin.version}</version>
        </plugin>
        <!-- Deletes target/ in this parent and in each module (`mvn clean`). -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <!-- Copies any src/main/resources of a module, minus the excludes in <resources> above,
             into its target/classes, and any src/test/resources into its target/test-classes. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <!-- Packages each module's compiled classes and resources into its jar. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <!-- Copies this parent's and each module's built artifacts into the local repository. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <!-- Uploads this parent's and each module's built artifacts to a remote repository. This
             build configures none. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>
        <!-- Generates the project site (`mvn site`). -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>${maven-site-plugin.version}</version>
        </plugin>
        <!-- Generates the project-information reports of `mvn site`, e.g. the pages listing
             the modules, dependencies and plugins. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-project-info-reports-plugin</artifactId>
          <version>${maven-project-info-reports-plugin.version}</version>
        </plugin>
        <!-- Checks (`mvn spotless:check`) or fixes (`mvn spotless:apply`) the format of each
             module's Java sources and of this parent's and each module's pom.xml. Java sources
             follow google-java-format, and sortpom formats each pom.xml. This build binds none of
             Spotless's goals to a lifecycle phase, so they run only when called directly. -->
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <!-- Limits both goals to the files changed since the current branch forked from
                 origin/master. A file nobody touches keeps its current format, so no single
                 reformat-everything diff buries real changes. -->
            <ratchetFrom>origin/master</ratchetFrom>
            <java>
              <googleJavaFormat>
                <version>${google-java-format.version}</version>
                <style>GOOGLE</style>
              </googleJavaFormat>
            </java>
            <!-- sortpom sorts the elements of each pom.xml by the predefined sort order
                 recommended_2008_06. That order follows Maven's POM code convention for the
                 top-level elements and sortpom's own order for nested ones. Repeated elements,
                 such as each <dependency>, keep their order. sortpom also re-indents the file.
                 It writes each empty element in short form, as in <argLine/>. It writes the
                 <project> start tag on one line. The <quiet> setting hides sortpom's info logs. -->
            <pom>
              <sortPom>
                <version>${sortpom-sorter.version}</version>
                <predefinedSortOrder>recommended_2008_06</predefinedSortOrder>
                <expandEmptyElements>false</expandEmptyElements>
                <quiet>true</quiet>
              </sortPom>
            </pom>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Checks three rules at validate, the default lifecycle's first phase. They therefore
           run in every build that runs a phase of that lifecycle (e.g. `mvn test`).
           requirePluginVersions fails the build when a plugin of the build has no fixed version
           in this parent's or a module's pom. It skips a plugin that only <pluginManagement>
           declares and whose goals this build binds to no lifecycle phase. Its
           <additionalPlugins> list therefore names each such plugin. requireMavenVersion fails
           the build when Maven is older than 3.9, and requireJavaVersion when the JDK is older
           than the java.version property. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-build-rules</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requirePluginVersions>
                  <additionalPlugins>
                    <additionalPlugin>com.diffplug.spotless:spotless-maven-plugin</additionalPlugin>
                    <additionalPlugin>org.apache.maven.plugins:maven-dependency-plugin</additionalPlugin>
                    <additionalPlugin>org.apache.maven.plugins:maven-project-info-reports-plugin</additionalPlugin>
                  </additionalPlugins>
                </requirePluginVersions>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[${java.version},)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
