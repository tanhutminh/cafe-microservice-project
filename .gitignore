# Java / Maven
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
hs_err_pid*.log
replay_pid*.log

# IDE
.idea/
*.iml
# .vscode/launch.json, tasks.json, extensions.json are shared team config —
# tracked intentionally. Only ignore personal workspace settings.
.vscode/settings.json
.classpath
.project
.settings/
.factorypath

# Node / Angular
node_modules/
dist/
.angular/
npm-debug.log*

# Env / secrets
.env
# Spring's own application-{profile}.yml naming (e.g. application-local.yml) - a trailing
# comment on the same line as a pattern is NOT a comment in .gitignore syntax, so this needs
# its own line.
*-local.yml

# OS
.DS_Store
Thumbs.db

# Claude Code local session state
.claude/settings.local.json

# Helm - packaged chart archives generated by `helm dependency update`, not source
charts/*/charts/*.tgz

# Docker - local docker-compose overrides, not shared/tracked source
docker-compose.override.yml
