{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Debug auth-service (infra via Docker)",
      "request": "launch",
      "mainClass": "com.cafe.authservice.AuthServiceApplication",
      "projectName": "auth-service",
      "vmArgs": "-Xmx256m"
      // No env overrides needed — application.yml's default datasource URL
      // (Postgres on localhost:5432) already matches docker-compose's host
      // port mapping for the postgres container.
    },
    {
      "type": "chrome",
      "name": "Debug Angular (Chrome)",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMapPathOverrides": {
        "webpack:/*": "${webRoot}/*"
      }
    }
  ]
}
