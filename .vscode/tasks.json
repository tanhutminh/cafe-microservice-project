{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start M0 infra (Docker)",
      "type": "shell",
      "command": "docker compose up -d postgres config-server eureka-server gateway",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Stop auth-service container (so VS Code can debug it instead)",
      "type": "shell",
      "command": "docker compose stop auth-service",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Start Angular dev server",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
